<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:dsh="http://dsh.ai/bpmn"
             targetNamespace="http://dsh.ai/bpmn/examples">

  <process id="dshSampleApproval" name="DSH 示例审批流程" isExecutable="true">

    <extensionElements>
      <dsh:contextVariables>
        <dsh:contextVariable name="approvalResult" type="object" description="审批结论">
          <dsh:field name="conclusion" type="string" description="approved / rejected"/>
          <dsh:field name="comment" type="string" description="审批说明"/>
        </dsh:contextVariable>
      </dsh:contextVariables>
    </extensionElements>

    <startEvent id="startEvent" name="开始"/>

    <userTask id="approveTask" name="审批"
              flowable:candidateGroups="role-approver-uuid">
      <extensionElements>
        <dsh:assignmentRule candidateRoleId="role-approver-uuid"/>
        <!-- userPrompt 存 text 属性(非元素正文):引擎 StAX 非实体替换模式下,
             含引号的正文被切成多个 CHARACTER 事件,setElementText 只保留最后一段;
             属性值由 getAttributeValue 一次性完整解码。换行写 &#10;(字面换行会被属性规范化成空格)。 -->
        <dsh:userPrompt text="你当前的角色为审批专员,请基于申请摘要 {{upstream.applicationSummary}}、金额 {{upstream.amount}} 元,应用 skill approval-helper、compliance-check 做审批工作,给出审批结论(approved/rejected)并附简短说明。请以以下的JSON格式进行输出(approvalResult):&#10;{&#10;  &quot;conclusion&quot;: &quot;approved&quot;,&#10;  &quot;comment&quot;: &quot;&quot;&#10;}"/>
        <dsh:skillRef>approval-helper</dsh:skillRef>
        <dsh:skillRef>compliance-check</dsh:skillRef>
        <dsh:actionPolicy>
          <dsh:timeoutPolicy duration="PT24H" escalateToRoleId="role-manager-uuid"/>
          <dsh:sodRule type="not-applicant"/>
        </dsh:actionPolicy>
        <dsh:outputMappings>
          <dsh:mapping source="" target="approvalResult"/>
        </dsh:outputMappings>
      </extensionElements>
    </userTask>

    <!--
      async=true:引擎不阻塞主流程线程,改由 async-executor 线程池异步执行 Job。
      LLM 调用耗时长(数十秒到分钟级),不阻塞流程实例推进线程,避免占用引擎同步线程。
      失败时 Job 进入异常重试(次数/间隔由 flowable:failedJobRetryTimeCycle 控制,此处 R5/PT5M 即最多重试 5 次,间隔 5 分钟)。
      详参见 §9.3 自动节点失败处理策略。
    -->
    <serviceTask id="autoArchiveTask" name="自动归档"
                 flowable:delegateExpression="${dshServiceTaskDelegate}"
                 flowable:async="true"
                 flowable:failedJobRetryTimeCycle="R5/PT5M"/>

    <endEvent id="endEvent" name="结束"/>

    <sequenceFlow sourceRef="startEvent" targetRef="approveTask"/>
    <sequenceFlow sourceRef="approveTask" targetRef="autoArchiveTask"/>
    <sequenceFlow sourceRef="autoArchiveTask" targetRef="endEvent"/>

  </process>
</definitions>
