# 复制为 .env.local 并填入实际值
# 参见 docs/plans/2026-08-19-supabase-setup-guide.md §2 获取方式

# Supabase 项目 URL,形如 https://xxx.supabase.co
VITE_SUPABASE_URL=https://xxx.supabase.co

# Supabase anon/public key(前端认证用,不是 service_role)
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Web Console 后端 API base URL
# 开发时留空,通过 Vite proxy 走 /api → http://localhost:8080
# 生产环境填实际地址,如 https://console-api.example.com
VITE_API_BASE_URL=
